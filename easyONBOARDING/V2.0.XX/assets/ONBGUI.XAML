<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="easyONBOARDING - Neuer Benutzer"
    Width="1400"
    Height="900"
    MinWidth="1200"
    MinHeight="800"
    Background="#F5F5F5"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!--  Standalone Styles ohne externe Abhängigkeiten  -->

        <!--  Farben  -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#0078D4" />
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#106EBE" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#4CAF50" />
        <SolidColorBrush x:Key="WarningBrush" Color="#FF9800" />
        <SolidColorBrush x:Key="DangerBrush" Color="#F44336" />
        <SolidColorBrush x:Key="LightGrayBrush" Color="#F5F5F5" />
        <SolidColorBrush x:Key="MediumGrayBrush" Color="#E0E0E0" />
        <SolidColorBrush x:Key="DarkGrayBrush" Color="#9E9E9E" />
        <SolidColorBrush x:Key="TextBrush" Color="#333333" />
        <SolidColorBrush x:Key="WhiteBrush" Color="White" />

        <!--  Button Style  -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="15,8" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#005A9E" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Navigation Button Style  -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource LightGrayBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <!-- Aktiver Tab Style: IsEnabled=False zeigt aktiven Tab an -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                <Setter Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  TextBox Style  -->
        <Style TargetType="TextBox">
            <Setter Property="BorderBrush" Value="{StaticResource MediumGrayBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter Property="Background" Value="{StaticResource LightGrayBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ComboBox Style  -->
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="BorderBrush" Value="{StaticResource MediumGrayBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!--  Card Style  -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource MediumGrayBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                        BlurRadius="6"
                        Direction="270"
                        Opacity="0.2"
                        ShadowDepth="2"
                        Color="LightGray" />
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Section Header Style  -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Margin" Value="0,15,0,10" />
        </Style>

        <!--  Badge Styles  -->
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <Style
            x:Key="SuccessBadge"
            BasedOn="{StaticResource Badge}"
            TargetType="Border">
            <Setter Property="Background" Value="#E8F5E8" />
            <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style
            x:Key="WarningBadge"
            BasedOn="{StaticResource Badge}"
            TargetType="Border">
            <Setter Property="Background" Value="#FFF3E0" />
            <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style
            x:Key="InfoBadge"
            BasedOn="{StaticResource Badge}"
            TargetType="Border">
            <Setter Property="Background" Value="#E3F2FD" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="4" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="6"
                    Direction="270"
                    Opacity="0.2"
                    ShadowDepth="2"
                    Color="Black" />
            </Border.Effect>
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Logo/Title  -->
                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Border
                        Width="40"
                        Height="40"
                        Margin="0,0,15,0"
                        Background="White"
                        CornerRadius="20">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="24"
                            Text="👤" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            FontSize="22"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="easyONB" />
                        <TextBlock
                            FontSize="12"
                            Foreground="#E0E0E0"
                            Text="Onboarding neue Mitarbeiter" />
                    </StackPanel>
                </StackPanel>

                <!--  Progress Indicator  -->
                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Border
                        x:Name="stepIndicator1"
                        Width="30"
                        Height="30"
                        Margin="5"
                        Background="White"
                        CornerRadius="15">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Foreground="{StaticResource PrimaryBrush}"
                            Text="1" />
                    </Border>
                    <Rectangle
                        Width="20"
                        Height="2"
                        VerticalAlignment="Center"
                        Fill="White" />
                    <Border
                        x:Name="stepIndicator2"
                        Width="30"
                        Height="30"
                        Margin="5"
                        Background="#80FFFFFF"
                        CornerRadius="15">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="2" />
                    </Border>
                    <Rectangle
                        Width="20"
                        Height="2"
                        VerticalAlignment="Center"
                        Fill="#80FFFFFF" />
                    <TextBlock
                        Margin="10,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="White"
                        Text="..." />
                    <Rectangle
                        Width="20"
                        Height="2"
                        VerticalAlignment="Center"
                        Fill="#80FFFFFF" />
                    <Border
                        x:Name="stepIndicator6"
                        Width="30"
                        Height="30"
                        Margin="5"
                        Background="#80FFFFFF"
                        CornerRadius="15">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="6" />
                    </Border>
                    <Rectangle
                        Width="20"
                        Height="2"
                        VerticalAlignment="Center"
                        Fill="#80FFFFFF" />
                    <Border
                        x:Name="stepIndicator7"
                        Width="30"
                        Height="30"
                        Margin="5"
                        Background="#80FFFFFF"
                        CornerRadius="15">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="7" />
                    </Border>
                </StackPanel>

                <!--  Action Buttons  -->
                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        x:Name="btnHelp"
                        Width="30"
                        Height="30"
                        Margin="5"
                        Background="Transparent"
                        BorderBrush="White"
                        BorderThickness="1"
                        Content="?"
                        FontWeight="Bold"
                        Foreground="White"
                        ToolTip="Hilfe" />
                    <Button
                        x:Name="btnSettings"
                        Width="30"
                        Height="30"
                        Margin="5"
                        Background="Transparent"
                        BorderBrush="White"
                        BorderThickness="1"
                        Content="⚙"
                        FontWeight="Bold"
                        Foreground="White"
                        ToolTip="Einstellungen" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  Progress Bar  -->
        <ProgressBar
            x:Name="mainProgressBar"
            Grid.Row="1"
            Background="{StaticResource LightGrayBrush}"
            BorderThickness="0"
            Foreground="{StaticResource SuccessBrush}"
            Maximum="7"
            Minimum="0"
            Value="1" />

        <!--  Main Content  -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Navigation Sidebar  -->
            <Border
                Grid.Column="0"
                Background="White"
                BorderBrush="{StaticResource MediumGrayBrush}"
                BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,15">
                        <!--  Navigation Header  -->
                        <TextBlock
                            Margin="5,0,0,15"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="{StaticResource PrimaryBrush}"
                            Text="Onboarding-Schritte" />

                        <!--  Step Navigation  -->
                        <Button
                            x:Name="btnStep1"
                            IsEnabled="False"
                            Style="{StaticResource NavButton}"
                            Tag="1">
                            <StackPanel Orientation="Horizontal">
                                <Border
                                    Width="18"
                                    Height="18"
                                    Margin="0,0,8,0"
                                    Background="{StaticResource SuccessBrush}"
                                    CornerRadius="9">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        Text="✓" />
                                </Border>
                                <TextBlock VerticalAlignment="Center" Text="1. Benutzerdaten" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="btnStep2"
                            Style="{StaticResource NavButton}"
                            Tag="2">
                            <StackPanel Orientation="Horizontal">
                                <Border
                                    Width="18"
                                    Height="18"
                                    Margin="0,0,8,0"
                                    Background="{StaticResource MediumGrayBrush}"
                                    CornerRadius="9">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        Text="2" />
                                </Border>
                                <TextBlock VerticalAlignment="Center" Text="2. Gruppen" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="btnStep3"
                            Style="{StaticResource NavButton}"
                            Tag="3">
                            <StackPanel Orientation="Horizontal">
                                <Border
                                    Width="18"
                                    Height="18"
                                    Margin="0,0,8,0"
                                    Background="{StaticResource MediumGrayBrush}"
                                    CornerRadius="9">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        Text="3" />
                                </Border>
                                <TextBlock VerticalAlignment="Center" Text="3. Erweiterte Einstellungen" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="btnStep7"
                            Style="{StaticResource NavButton}"
                            Tag="7">
                            <StackPanel Orientation="Horizontal">
                                <Border
                                    Width="18"
                                    Height="18"
                                    Margin="0,0,8,0"
                                    Background="{StaticResource MediumGrayBrush}"
                                    CornerRadius="9">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Foreground="White"
                                        Text="7" />
                                </Border>
                                <TextBlock VerticalAlignment="Center" Text="4. Zusammenfassung" />
                            </StackPanel>
                        </Button>

                        <!--  Progress Info  -->
                        <Border Margin="5,20,5,0" Style="{StaticResource InfoBadge}">
                            <StackPanel>
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource PrimaryBrush}"
                                    Text="Fortschritt" />
                                <TextBlock
                                    x:Name="progressText"
                                    FontSize="10"
                                    Foreground="{StaticResource DarkGrayBrush}"
                                    Text="20% abgeschlossen" />
                            </StackPanel>
                        </Border>

                        <!--  Info Box  -->
                        <Border
                            Margin="5,15,5,0"
                            Padding="10"
                            Background="#E3F2FD"
                            BorderBrush="{StaticResource PrimaryBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                            <StackPanel>
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource PrimaryBrush}"
                                    Text="💡 Hinweis" />
                                <TextBlock
                                    x:Name="infoText"
                                    Margin="0,3,0,0"
                                    FontSize="10"
                                    Foreground="{StaticResource PrimaryBrush}"
                                    Text="Der Benutzer wird nach Schritt 2 (Gruppen) erstellt. Weitere Schritte aktualisieren den Benutzer."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!--  Content Area  -->
            <ScrollViewer
                Grid.Column="1"
                Padding="10"
                VerticalScrollBarVisibility="Auto">
                <Grid x:Name="contentGrid">
                    <Grid.Resources>
                        <Style x:Key="FormLabel" TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="FontWeight" Value="Normal" />
                            <Setter Property="Margin" Value="0,0,5,0" />
                        </Style>
                    </Grid.Resources>

                    <!--  Step 1: Benutzerdaten  -->
                    <Border
                        x:Name="step1Panel"
                        Style="{StaticResource Card}"
                        Visibility="Visible">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,20"
                                FontSize="18"
                                FontWeight="Bold"
                                Text="Schritt 1: Benutzerdaten" />

                            <!--  Template Selection  -->
                            <TextBlock Style="{StaticResource SectionHeader}" Text="Vorlage laden (Optional)" />
                            <Border
                                Margin="0,0,0,15"
                                Padding="15"
                                Background="{StaticResource LightGrayBrush}"
                                CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        FontWeight="SemiBold"
                                        Style="{StaticResource FormLabel}"
                                        Text="Profil auswählen:" />
                                    <ComboBox
                                        x:Name="cmbTemplate"
                                        Grid.Column="1"
                                        ToolTip="Wählen Sie ein Profil, um die Felder vorab auszufüllen." />
                                    <Button
                                        x:Name="btnLoadTemplates"
                                        Grid.Column="2"
                                        Margin="10,0,0,0"
                                        Content="Vorlagen laden"
                                        Style="{StaticResource ModernButton}" />
                                </Grid>
                            </Border>

                            <!--  Basic Info  -->
                            <TextBlock Style="{StaticResource SectionHeader}" Text="Grundlegende Informationen" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Style="{StaticResource FormLabel}"
                                    Text="Vorname: *" />
                                <TextBox
                                    x:Name="txtFirstName"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    ToolTip="Vorname des Benutzers" />

                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="3"
                                    Style="{StaticResource FormLabel}"
                                    Text="Nachname: *" />
                                <TextBox
                                    x:Name="txtLastName"
                                    Grid.Row="0"
                                    Grid.Column="4"
                                    ToolTip="Nachname des Benutzers" />

                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Style="{StaticResource FormLabel}"
                                    Text="Benutzername:" />
                                <TextBox
                                    x:Name="txtUsername"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    IsReadOnly="True"
                                    ToolTip="Wird automatisch generiert" />

                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="3"
                                    Style="{StaticResource FormLabel}"
                                    Text="E-Mail:" />
                                <TextBox
                                    x:Name="txtEmail"
                                    Grid.Row="1"
                                    Grid.Column="4"
                                    IsReadOnly="True"
                                    ToolTip="Wird automatisch generiert" />

                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Style="{StaticResource FormLabel}"
                                    Text="Abteilung:" />
                                <ComboBox
                                    x:Name="cmbDepartment"
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    IsEditable="True" />

                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="3"
                                    Style="{StaticResource FormLabel}"
                                    Text="Position:" />
                                <TextBox
                                    x:Name="txtPosition"
                                    Grid.Row="2"
                                    Grid.Column="4" />

                                <TextBlock
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Style="{StaticResource FormLabel}"
                                    Text="Manager:" />
                                <TextBox
                                    x:Name="txtManager"
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="3" />
                                <Button
                                    x:Name="btnBrowseManager"
                                    Grid.Row="3"
                                    Grid.Column="4"
                                    Width="30"
                                    Margin="5,0,0,0"
                                    Content="..."
                                    ToolTip="Manager aus AD auswählen" />
                            </Grid>

                            <!--  Account Details  -->
                            <TextBlock Style="{StaticResource SectionHeader}" Text="Kontoinformationen" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Style="{StaticResource FormLabel}"
                                    Text="UPN:" />
                                <TextBox
                                    x:Name="txtUPN"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    IsReadOnly="True"
                                    ToolTip="User Principal Name (wird automatisch generiert)" />

                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="3"
                                    Style="{StaticResource FormLabel}"
                                    Text="Anzeigename:" />
                                <TextBox
                                    x:Name="txtDisplayName"
                                    Grid.Row="0"
                                    Grid.Column="4"
                                    IsReadOnly="True"
                                    ToolTip="Anzeigename (wird automatisch generiert)" />
                            </Grid>

                            <!--  OU Selection  -->
                            <TextBlock Style="{StaticResource SectionHeader}" Text="Active Directory" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Style="{StaticResource FormLabel}"
                                    Text="OU-Pfad: *" />
                                <ComboBox
                                    x:Name="cmbOUPath"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    IsEditable="True">
                                    <ComboBoxItem Content="OU=Users,DC=company,DC=local" />
                                    <ComboBoxItem Content="OU=IT,OU=Users,DC=company,DC=local" />
                                    <ComboBoxItem Content="OU=Sales,OU=Users,DC=company,DC=local" />
                                </ComboBox>
                                <Button
                                    x:Name="btnBrowseOU"
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    Width="30"
                                    Margin="5,0,0,0"
                                    Content="..." />

                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Style="{StaticResource FormLabel}"
                                    Text="Passwort:" />
                                <PasswordBox
                                    x:Name="pwdPassword"
                                    Grid.Row="1"
                                    Grid.Column="1" />
                                <Button
                                    x:Name="btnGeneratePassword"
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    Width="30"
                                    Margin="5,0,0,0"
                                    Content="🎲"
                                    ToolTip="Passwort generieren" />
                            </Grid>

                            <!--  Validation  -->
                            <Border
                                x:Name="validationPanel1"
                                Margin="0,15,0,0"
                                Padding="10"
                                Background="#FFEBEE"
                                BorderBrush="{StaticResource DangerBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Visibility="Collapsed">
                                <TextBlock
                                    x:Name="validationText1"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource DangerBrush}"
                                    Text="Bitte alle Pflichtfelder ausfüllen" />
                            </Border>

                            <!--  Step Buttons  -->
                            <StackPanel
                                Margin="0,20,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                                <Button
                                    x:Name="btnValidateStep1"
                                    Margin="0,0,10,0"
                                    Background="{StaticResource WarningBrush}"
                                    Content="Validieren"
                                    Style="{StaticResource ModernButton}" />
                                <Button
                                    x:Name="btnNextStep1"
                                    Content="Weiter &gt;"
                                    Style="{StaticResource ModernButton}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!--  Step 2: Gruppen (Benutzer wird hier erstellt!)  -->
                    <Border
                        x:Name="step2Panel"
                        Style="{StaticResource Card}"
                        Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,20"
                                FontSize="18"
                                FontWeight="Bold"
                                Text="Schritt 2: Gruppenzuweisung" />

                            <!--  Important Note  -->
                            <Border
                                Margin="0,0,0,15"
                                Padding="12"
                                Background="#FFF3E0"
                                BorderBrush="{StaticResource WarningBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        Foreground="{StaticResource WarningBrush}"
                                        Text="⚠" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource WarningBrush}"
                                        Text="Nach diesem Schritt wird der Benutzer im Active Directory erstellt!" />
                                </StackPanel>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!--  Available Groups  -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock
                                        Margin="0,0,0,5"
                                        FontWeight="SemiBold"
                                        Text="Verfügbare Gruppen" />
                                    <TextBox
                                        x:Name="txtGroupSearch"
                                        Margin="0,0,0,5"
                                        ToolTip="Gruppen suchen..." />
                                    <ListBox
                                        x:Name="lstAvailableGroups"
                                        Height="300"
                                        SelectionMode="Extended">
                                    </ListBox>
                                </StackPanel>

                                <!--  Move Buttons  -->
                                <StackPanel
                                    Grid.Column="1"
                                    Margin="10,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <Button
                                        x:Name="btnAddGroup"
                                        Width="50"
                                        Margin="5"
                                        Content="&gt;"
                                        ToolTip="Ausgewählte Gruppe hinzufügen" />
                                    <Button
                                        x:Name="btnAddAllGroups"
                                        Width="50"
                                        Margin="5"
                                        Content="&gt;&gt;"
                                        ToolTip="Alle Gruppen hinzufügen" />
                                    <Button
                                        x:Name="btnRemoveGroup"
                                        Width="50"
                                        Margin="5"
                                        Content="&lt;"
                                        ToolTip="Ausgewählte Gruppe entfernen" />
                                    <Button
                                        x:Name="btnRemoveAllGroups"
                                        Width="50"
                                        Margin="5"
                                        Content="&lt;&lt;"
                                        ToolTip="Alle Gruppen entfernen" />
                                </StackPanel>

                                <!--  Selected Groups  -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock
                                        Margin="0,0,0,5"
                                        FontWeight="SemiBold"
                                        Text="Zugewiesene Gruppen" />
                                    <Border Margin="0,0,0,5" Style="{StaticResource InfoBadge}">
                                        <TextBlock
                                            x:Name="groupCountText"
                                            FontSize="10"
                                            Text="0 Gruppen ausgewählt" />
                                    </Border>
                                    <ListBox
                                        x:Name="lstSelectedGroups"
                                        Height="300"
                                        SelectionMode="Extended" />
                                </StackPanel>
                            </Grid>

                            <!--  Step Buttons  -->
                            <StackPanel
                                Margin="0,20,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                                <Button
                                    x:Name="btnPrevStep2"
                                    Margin="0,0,10,0"
                                    Background="{StaticResource DarkGrayBrush}"
                                    Content="Zurück"
                                    Style="{StaticResource ModernButton}" />
                                <Button
                                    x:Name="btnCreateUser"
                                    Background="{StaticResource SuccessBrush}"
                                    Content="Benutzer erstellen"
                                    Style="{StaticResource ModernButton}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!--  Step 3: Erweiterte Einstellungen (User Update)  -->
                    <Border
                        x:Name="step3Panel"
                        Style="{StaticResource Card}"
                        Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,20"
                                FontSize="18"
                                FontWeight="Bold"
                                Text="Schritt 3: Erweiterte Einstellungen" />

                            <!--  User Status  -->
                            <Border Margin="0,0,0,15" Style="{StaticResource SuccessBadge}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,5,0"
                                        FontWeight="Bold"
                                        Text="✓" />
                                    <TextBlock
                                        x:Name="userStatusText"
                                        FontWeight="SemiBold"
                                        Text="Benutzer erfolgreich erstellt" />
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource SectionHeader}" Text="Kontaktinformationen" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Style="{StaticResource FormLabel}"
                                    Text="Telefon:" />
                                <TextBox
                                    x:Name="txtPhone"
                                    Grid.Row="0"
                                    Grid.Column="1" />

                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="3"
                                    Style="{StaticResource FormLabel}"
                                    Text="Mobil:" />
                                <TextBox
                                    x:Name="txtMobile"
                                    Grid.Row="0"
                                    Grid.Column="4" />

                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Style="{StaticResource FormLabel}"
                                    Text="Büro:" />
                                <TextBox
                                    x:Name="txtOffice"
                                    Grid.Row="1"
                                    Grid.Column="1" />

                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="3"
                                    Style="{StaticResource FormLabel}"
                                    Text="Standort:" />
                                <TextBox
                                    x:Name="txtLocation"
                                    Grid.Row="1"
                                    Grid.Column="4" />

                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Style="{StaticResource FormLabel}"
                                    Text="Beschreibung:" />
                                <TextBox
                                    x:Name="txtDescription"
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="4" />
                            </Grid>

                            <TextBlock Style="{StaticResource SectionHeader}" Text="Adressinformationen" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Style="{StaticResource FormLabel}"
                                    Text="Straße:" />
                                <TextBox
                                    x:Name="txtStreetAddress"
                                    Grid.Row="0"
                                    Grid.Column="1" />

                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="3"
                                    Style="{StaticResource FormLabel}"
                                    Text="Stadt:" />
                                <TextBox
                                    x:Name="txtCity"
                                    Grid.Row="0"
                                    Grid.Column="4" />

                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Style="{StaticResource FormLabel}"
                                    Text="Bundesland:" />
                                <TextBox
                                    x:Name="txtState"
                                    Grid.Row="1"
                                    Grid.Column="1" />

                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="3"
                                    Style="{StaticResource FormLabel}"
                                    Text="PLZ:" />
                                <TextBox
                                    x:Name="txtPostalCode"
                                    Grid.Row="1"
                                    Grid.Column="4" />

                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Style="{StaticResource FormLabel}"
                                    Text="Land:" />
                                <TextBox
                                    x:Name="txtCountry"
                                    Grid.Row="2"
                                    Grid.Column="1" />

                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="3"
                                    Style="{StaticResource FormLabel}"
                                    Text="Firma:" />
                                <TextBox
                                    x:Name="txtCompany"
                                    Grid.Row="2"
                                    Grid.Column="4" />
                            </Grid>

                            <TextBlock Style="{StaticResource SectionHeader}" Text="Konto-Optionen" />
                            <StackPanel>
                                <CheckBox
                                    x:Name="chkMustChangePassword"
                                    Margin="5"
                                    Content="Benutzer muss Passwort bei nächster Anmeldung ändern"
                                    IsChecked="True" />
                                <CheckBox
                                    x:Name="chkPasswordNeverExpires"
                                    Margin="5"
                                    Content="Passwort läuft nie ab" />
                                <CheckBox
                                    x:Name="chkCannotChangePassword"
                                    Margin="5"
                                    Content="Benutzer kann Passwort nicht ändern" />
                                <CheckBox
                                    x:Name="chkAccountDisabled"
                                    Margin="5"
                                    Content="Konto deaktiviert" />
                            </StackPanel>

                            <!--  Step Buttons  -->
                            <StackPanel
                                Margin="0,20,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                                <Button
                                    x:Name="btnPrevStep3"
                                    Margin="0,0,10,0"
                                    Background="{StaticResource DarkGrayBrush}"
                                    Content="Zurück"
                                    Style="{StaticResource ModernButton}" />
                                <Button
                                    x:Name="btnUpdateUser3"
                                    Margin="0,0,10,0"
                                    Background="{StaticResource WarningBrush}"
                                    Content="Benutzer aktualisieren"
                                    Style="{StaticResource ModernButton}" />
                                <Button
                                    x:Name="btnNextStep3"
                                    Content="Weiter &gt;"
                                    Style="{StaticResource ModernButton}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!--  Step 7: Abschluss  -->
                    <Border
                        x:Name="step7Panel"
                        Style="{StaticResource Card}"
                        Visibility="Collapsed">
                        <StackPanel>
                            <StackPanel Margin="0,0,0,20" Orientation="Horizontal">
                                <TextBlock
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Text="Schritt 7: Zusammenfassung &amp; Abschluss" />
                                <Border Margin="15,0,0,0" Style="{StaticResource SuccessBadge}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Margin="0,0,5,0"
                                            FontWeight="Bold"
                                            Text="✓" />
                                        <TextBlock FontWeight="SemiBold" Text="Alle Schritte bereit zum Abschluss" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!--  Summary Details  -->
                            <TextBlock Style="{StaticResource SectionHeader}" Text="Übersicht der Konfiguration" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!--  Left Column  -->
                                <StackPanel Grid.Column="0">
                                    <GroupBox
                                        Margin="0,0,0,10"
                                        Padding="10"
                                        Header="Benutzer &amp; AD">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                FontWeight="SemiBold"
                                                Style="{StaticResource FormLabel}"
                                                Text="Name:" />
                                            <TextBlock
                                                x:Name="summaryFullName"
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Text="Max Mustermann" />
                                            <TextBlock
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                FontWeight="SemiBold"
                                                Style="{StaticResource FormLabel}"
                                                Text="Benutzername:" />
                                            <TextBlock
                                                x:Name="summaryUsername"
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Text="mmustermann" />
                                            <TextBlock
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                FontWeight="SemiBold"
                                                Style="{StaticResource FormLabel}"
                                                Text="SamAccountName:" />
                                            <TextBlock
                                                x:Name="txtSamAccountName"
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Text="mmustermann" />
                                            <TextBlock
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                FontWeight="SemiBold"
                                                Style="{StaticResource FormLabel}"
                                                Text="E-Mail:" />
                                            <TextBlock
                                                x:Name="summaryEmail"
                                                Grid.Row="2"
                                                Grid.Column="1"
                                                Text="max.mustermann@company.com" />
                                            <TextBlock
                                                Grid.Row="3"
                                                Grid.Column="0"
                                                FontWeight="SemiBold"
                                                Style="{StaticResource FormLabel}"
                                                Text="Abteilung:" />
                                            <TextBlock
                                                x:Name="summaryDepartment"
                                                Grid.Row="3"
                                                Grid.Column="1"
                                                Text="IT" />
                                            <TextBlock
                                                Grid.Row="4"
                                                Grid.Column="0"
                                                FontWeight="SemiBold"
                                                Style="{StaticResource FormLabel}"
                                                Text="Position:" />
                                            <TextBlock
                                                x:Name="summaryPosition"
                                                Grid.Row="4"
                                                Grid.Column="1"
                                                Text="Systemadministrator" />
                                            <TextBlock
                                                Grid.Row="5"
                                                Grid.Column="0"
                                                FontWeight="SemiBold"
                                                Style="{StaticResource FormLabel}"
                                                Text="OU:" />
                                            <TextBlock
                                                x:Name="summaryOU"
                                                Grid.Row="5"
                                                Grid.Column="1"
                                                Text="OU=IT,OU=Users,DC=company,DC=local"
                                                TextWrapping="Wrap" />
                                        </Grid>
                                    </GroupBox>
                                    <GroupBox Padding="10" Header="Microsoft 365">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                FontWeight="SemiBold"
                                                Style="{StaticResource FormLabel}"
                                                Text="Status:" />
                                            <TextBlock
                                                x:Name="summaryM365Status"
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Foreground="{StaticResource SuccessBrush}"
                                                Text="Aktiviert" />
                                            <TextBlock
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                FontWeight="SemiBold"
                                                Style="{StaticResource FormLabel}"
                                                Text="Lizenz:" />
                                            <TextBlock
                                                x:Name="summaryM365License"
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Text="Microsoft 365 Business Standard" />
                                            <TextBlock
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                FontWeight="SemiBold"
                                                Style="{StaticResource FormLabel}"
                                                Text="Postfach:" />
                                            <TextBlock
                                                x:Name="summaryMailboxStatus"
                                                Grid.Row="2"
                                                Grid.Column="1"
                                                Text="Erstellt und konfiguriert" />
                                        </Grid>
                                    </GroupBox>
                                </StackPanel>

                                <!--  Right Column  -->
                                <StackPanel Grid.Column="2">
                                    <GroupBox Padding="10" Header="Gruppenzugehörigkeiten">
                                        <StackPanel>
                                            <TextBlock
                                                x:Name="summaryGroupCount"
                                                Margin="0,0,0,5"
                                                FontWeight="SemiBold"
                                                Text="5 Gruppen zugewiesen" />
                                            <ListBox
                                                x:Name="summaryGroupList"
                                                Height="200"
                                                Background="{StaticResource LightGrayBrush}"
                                                BorderThickness="0">
                                                <ListBoxItem Content="Domain Users" />
                                                <ListBoxItem Content="IT-Team" />
                                                <ListBoxItem Content="VPN-Benutzer" />
                                                <ListBoxItem Content="Office365-Benutzer" />
                                                <ListBoxItem Content="Alle-Mitarbeiter" />
                                            </ListBox>
                                        </StackPanel>
                                    </GroupBox>
                                </StackPanel>
                            </Grid>

                            <TextBlock Style="{StaticResource SectionHeader}" Text="Abschließende Aktionen" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <CheckBox
                                        x:Name="chkSendWelcomeEmail"
                                        Margin="5"
                                        Content="Willkommens-E-Mail an Benutzer senden"
                                        IsChecked="True" />
                                    <CheckBox
                                        x:Name="chkNotifyManager"
                                        Margin="5"
                                        Content="Manager über neuen Benutzer informieren"
                                        IsChecked="True" />
                                    <CheckBox
                                        x:Name="chkSendPasswordToManager"
                                        Margin="25,0,5,5"
                                        Content="Generiertes Passwort an Manager senden"
                                        IsChecked="True" />
                                    <CheckBox
                                        x:Name="chkCreateDocumentation"
                                        Margin="5"
                                        Content="Dokumentation generieren"
                                        IsChecked="True" />
                                    <StackPanel Margin="25,0,5,5" Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource FormLabel}" Text="Format:" />
                                        <ComboBox x:Name="cmbDocFormat" Width="120">
                                            <ComboBoxItem Content="PDF" IsSelected="True" />
                                            <ComboBoxItem Content="Word" />
                                            <ComboBoxItem Content="Text" />
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Style="{StaticResource FormLabel}"
                                        Text="Abschluss-Protokoll:" />
                                    <TextBox
                                        x:Name="txtFinalLog"
                                        Height="120"
                                        IsReadOnly="True"
                                        Text="Bereit für den Abschluss..."
                                        TextWrapping="Wrap"
                                        VerticalScrollBarVisibility="Auto" />
                                </StackPanel>
                            </Grid>

                            <!--  Final Buttons  -->
                            <StackPanel
                                Margin="0,20,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                                <Button
                                    x:Name="btnPrevStep7"
                                    Margin="0,0,10,0"
                                    Background="{StaticResource DarkGrayBrush}"
                                    Content="&lt; Zurück"
                                    Style="{StaticResource ModernButton}" />
                                <Button
                                    x:Name="btnStartNew"
                                    Margin="0,0,10,0"
                                    Background="{StaticResource PrimaryBrush}"
                                    Content="Neuen Benutzer anlegen"
                                    Style="{StaticResource ModernButton}" />
                                <Button
                                    x:Name="btnFinalizeOnboarding"
                                    Background="{StaticResource SuccessBrush}"
                                    Content="Onboarding abschließen &amp; Schließen"
                                    FontWeight="Bold"
                                    Style="{StaticResource ModernButton}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </Grid>
            </ScrollViewer>
        </Grid>

        <!--  Footer  -->
        <Border
            Grid.Row="3"
            Background="White"
            BorderBrush="{StaticResource MediumGrayBrush}"
            BorderThickness="0,1,0,0">
            <StatusBar Padding="5">
                <StatusBar.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </ItemsPanelTemplate>
                </StatusBar.ItemsPanel>
                <StatusBarItem>
                    <StackPanel Margin="10,0" Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="Status:" />
                        <TextBlock
                            x:Name="statusTextFooter"
                            VerticalAlignment="Center"
                            Text="Bereit" />
                    </StackPanel>
                </StatusBarItem>
                <StatusBarItem Grid.Column="1" HorizontalAlignment="Center">
                    <ProgressBar
                        x:Name="actionProgressBar"
                        Width="250"
                        Height="12"
                        IsIndeterminate="True"
                        Visibility="Hidden" />
                </StatusBarItem>
                <StatusBarItem Grid.Column="2">
                    <TextBlock
                        x:Name="versionTextFooter"
                        Margin="0,0,10,0"
                        FontSize="11"
                        Foreground="{StaticResource DarkGrayBrush}"
                        Text="easyONBOARDING v2.0 | © 2025 Phin-IT" />
                </StatusBarItem>
            </StatusBar>
        </Border>
    </Grid>
</Window>
